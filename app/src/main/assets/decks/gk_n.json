[["naked", "ˈneɪkɪd", "adj. 裸露的", "You can see it with the naked eye.", "你用肉眼就能看到它。"], ["narrative", "ˈnærətɪv", "n. 叙述;故事", "The novel has a clear narrative.", "这部小说叙事清晰。"], ["nationwide", "ˌneɪʃnˈwaɪd", "adj./adv. 全国范围的", "The campaign went nationwide.", "这项活动推向了全国。"], ["negative", "ˈneɡətɪv", "adj. 消极的;否定的", "Try to avoid negative thoughts.", "尽量避免消极的想法。"], ["neglect", "nɪˈɡlekt", "v./n. 忽视;疏忽", "Don't neglect your health.", "不要忽视你的健康。"], ["negotiate", "nɪˈɡoʊʃieɪt", "v. 谈判", "The two sides negotiated a deal.", "双方谈成了一笔交易。"], ["nerve", "nɜːrv", "n. 神经;勇气", "It took nerve to speak up.", "开口需要勇气。"], ["network", "ˈnetwɜːrk", "n. 网络", "The train network covers the whole country.", "铁路网覆盖全国。"], ["neutral", "ˈnuːtrəl", "adj. 中立的", "He stayed neutral in the debate.", "他在辩论中保持中立。"], ["nevertheless", "ˌnevərðəˈles", "adv. 然而", "It was hard; nevertheless, she tried.", "这很难,然而她还是尝试了。"], ["nonsense", "ˈnɑːnsens", "n. 胡说;废话", "Don't talk nonsense.", "别胡说八道。"], ["norm", "nɔːrm", "n. 标准;规范", "Politeness is a social norm.", "礼貌是一种社会规范。"], ["normal", "ˈnɔːrml", "adj. 正常的", "His temperature is back to normal.", "他的体温恢复正常了。"], ["notion", "ˈnoʊʃn", "n. 概念;观念", "I have no notion of what happened.", "我完全不知道发生了什么。"], ["nowadays", "ˈnaʊədeɪz", "adv. 如今", "Nowadays, many people work online.", "如今许多人在网上工作。"], ["nuclear", "ˈnuːkliər", "adj. 核的", "Nuclear energy is very powerful.", "核能非常强大。"], ["numerous", "ˈnuːmərəs", "adj. 众多的", "She has numerous friends.", "她有众多的朋友。"], ["nutrition", "nuˈtrɪʃn", "n. 营养", "Good nutrition supports growth.", "良好的营养促进成长。"], ["objective", "əbˈdʒektɪv", "n./adj. 目标;客观的", "Our objective is to win.", "我们的目标是获胜。"], ["obligation", "ˌɑːblɪˈɡeɪʃn", "n. 义务", "We have an obligation to help.", "我们有帮助的义务。"], ["observe", "əbˈzɜːrv", "v. 观察;遵守", "Scientists observe the stars.", "科学家观察星星。"], ["obstacle", "ˈɑːbstəkl", "n. 障碍", "She overcame every obstacle.", "她克服了每一个障碍。"], ["obtain", "əbˈteɪn", "v. 获得", "He obtained a scholarship.", "他获得了奖学金。"], ["obvious", "ˈɑːbviəs", "adj. 明显的", "The answer is obvious.", "答案是显而易见的。"], ["occasion", "əˈkeɪʒn", "n. 场合;时机", "Wear this on special occasions.", "在特殊场合穿这件。"], ["occupy", "ˈɑːkjupaɪ", "v. 占据;占用", "Sports occupy much of his time.", "运动占据了他很多时间。"], ["occur", "əˈkɜːr", "v. 发生", "The accident occurred at night.", "事故发生在夜里。"], ["odd", "ɑːd", "adj. 奇怪的;奇数的", "That's an odd question.", "那是个奇怪的问题。"], ["operation", "ˌɑːpəˈreɪʃn", "n. 手术;操作", "The operation was a success.", "手术成功了。"], ["opponent", "əˈpoʊnənt", "n. 对手", "He defeated a strong opponent.", "他击败了一个强劲的对手。"], ["oppose", "əˈpoʊz", "v. 反对", "Many people oppose the idea.", "许多人反对这个想法。"], ["optimistic", "ˌɑːptɪˈmɪstɪk", "adj. 乐观的", "Stay optimistic about the future.", "对未来保持乐观。"], ["option", "ˈɑːpʃn", "n. 选择", "You have two options here.", "你在这里有两个选择。"], ["organ", "ˈɔːrɡən", "n. 器官;风琴", "The heart is a vital organ.", "心脏是重要的器官。"], ["organic", "ɔːrˈɡænɪk", "adj. 有机的", "They grow organic vegetables.", "他们种植有机蔬菜。"], ["organize", "ˈɔːrɡənaɪz", "v. 组织", "She organized a charity event.", "她组织了一场慈善活动。"], ["origin", "ˈɔːrɪdʒɪn", "n. 起源", "The origin of the word is unknown.", "这个词的起源不明。"], ["original", "əˈrɪdʒənl", "adj./n. 原来的;原件", "This is the original painting.", "这是原画。"], ["otherwise", "ˈʌðərwaɪz", "adv. 否则", "Hurry, otherwise you'll be late.", "快点,否则你会迟到。"], ["outcome", "ˈaʊtkʌm", "n. 结果", "We are happy with the outcome.", "我们对结果很满意。"], ["output", "ˈaʊtpʊt", "n. 产量;输出", "The factory increased its output.", "工厂提高了产量。"], ["overcome", "ˌoʊvərˈkʌm", "v. 克服", "She overcame her fear of water.", "她克服了对水的恐惧。"], ["overlook", "ˌoʊvərˈlʊk", "v. 忽略;俯瞰", "Don't overlook the small details.", "不要忽略小细节。"], ["overseas", "ˌoʊvərˈsiːz", "adj./adv. 海外的", "He studies overseas.", "他在海外求学。"], ["owe", "oʊ", "v. 欠", "I owe you an apology.", "我该向你道歉。"], ["owl", "aʊl", "n. 猫头鹰", "The owl hunts at night.", "猫头鹰在夜里捕食。"]]

[["jealous", "ˈdʒeləs", "adj. 嫉妒的", "She was jealous of her friend's success.", "她嫉妒朋友的成功。"], ["justice", "ˈdʒʌstɪs", "n. 正义;公正", "People long for justice.", "人们渴望正义。"], ["justify", "ˈdʒʌstɪfaɪ", "v. 证明……正当", "Nothing can justify lying.", "没有什么能为撒谎辩护。"], ["keen", "kiːn", "adj. 热衷的;敏锐的", "He is keen on playing chess.", "他热衷于下棋。"], ["kettle", "ˈketl", "n. 水壶", "The kettle is boiling.", "水壶里的水开了。"], ["kingdom", "ˈkɪŋdəm", "n. 王国", "The lion rules the animal kingdom.", "狮子统治着动物王国。"], ["label", "ˈleɪbl", "n./v. 标签;贴标签", "Read the label before use.", "使用前请阅读标签。"], ["labor", "ˈleɪbər", "n./v. 劳动;劳工", "Success requires hard labor.", "成功需要辛勤的劳动。"], ["lack", "læk", "n./v. 缺乏", "He failed for lack of practice.", "他因缺乏练习而失败。"], ["landscape", "ˈlændskeɪp", "n. 风景", "The mountain landscape is stunning.", "山间风景令人惊叹。"], ["launch", "lɔːntʃ", "v./n. 发射;发起", "They launched a new product.", "他们推出了一款新产品。"], ["layer", "ˈleɪər", "n. 层", "There is a thin layer of ice.", "有一层薄冰。"], ["leadership", "ˈliːdərʃɪp", "n. 领导;领导能力", "Good leadership inspires a team.", "优秀的领导激励团队。"], ["league", "liːɡ", "n. 联盟;联赛", "Our team plays in the school league.", "我们队参加校际联赛。"], ["leak", "liːk", "v./n. 泄漏", "Water is leaking from the pipe.", "水管在漏水。"], ["lecture", "ˈlektʃər", "n./v. 讲座;演讲", "We attended a science lecture.", "我们参加了一场科学讲座。"], ["legal", "ˈliːɡl", "adj. 合法的", "This is a legal agreement.", "这是一份合法协议。"], ["leisure", "ˈliːʒər", "n. 闲暇", "She reads in her leisure time.", "她在闲暇时读书。"], ["license", "ˈlaɪsns", "n. 执照;许可证", "He has a driver's license.", "他有驾照。"], ["likely", "ˈlaɪkli", "adj./adv. 可能的", "It is likely to rain tonight.", "今晚可能会下雨。"], ["limit", "ˈlɪmɪt", "n./v. 限制", "There is a limit to my patience.", "我的耐心是有限度的。"], ["link", "lɪŋk", "n./v. 联系;链接", "There is a link between diet and health.", "饮食和健康之间有联系。"], ["liquid", "ˈlɪkwɪd", "n./adj. 液体", "Water is a common liquid.", "水是常见的液体。"], ["literature", "ˈlɪtrətʃər", "n. 文学", "She studies English literature.", "她研究英国文学。"], ["load", "loʊd", "n./v. 负载;装载", "The truck carried a heavy load.", "卡车载着沉重的货物。"], ["loan", "loʊn", "n./v. 贷款", "He took a loan to buy a house.", "他贷款买了房子。"], ["local", "ˈloʊkl", "adj. 当地的", "We ate at a local restaurant.", "我们在一家当地餐馆吃饭。"], ["locate", "ˈloʊkeɪt", "v. 位于;找到", "The hotel is located near the sea.", "这家酒店位于海边。"], ["logic", "ˈlɑːdʒɪk", "n. 逻辑", "There is no logic in his argument.", "他的论点毫无逻辑。"], ["loose", "luːs", "adj. 松的", "The screw is loose.", "这颗螺丝松了。"], ["luxury", "ˈlʌkʃəri", "n. 奢侈;奢侈品", "A car was once a luxury.", "汽车曾经是奢侈品。"]]

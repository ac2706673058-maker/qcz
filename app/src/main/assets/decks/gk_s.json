[["sacrifice", "ˈsækrɪfaɪs", "v./n. 牺牲", "Parents sacrifice a lot for children.", "父母为孩子牺牲很多。"], ["satellite", "ˈsætəlaɪt", "n. 卫星", "The satellite sends signals to earth.", "卫星向地球发送信号。"], ["satisfaction", "ˌsætɪsˈfækʃn", "n. 满意", "She smiled with satisfaction.", "她满意地笑了。"], ["satisfy", "ˈsætɪsfaɪ", "v. 使满意", "The result satisfied everyone.", "结果让每个人都满意。"], ["scale", "skeɪl", "n. 规模;刻度", "The project was built on a large scale.", "这个项目是大规模建造的。"], ["scan", "skæn", "v. 扫描;浏览", "She scanned the page quickly.", "她快速浏览了这一页。"], ["scandal", "ˈskændl", "n. 丑闻", "The scandal shocked the public.", "这桩丑闻震惊了公众。"], ["scarce", "skers", "adj. 稀缺的", "Clean water is scarce there.", "那里清洁的水很稀缺。"], ["scare", "sker", "v. 惊吓", "The dark scares small children.", "黑暗吓到小孩子。"], ["scene", "siːn", "n. 场景;现场", "The film has a funny scene.", "这部电影有个有趣的场景。"], ["scenery", "ˈsiːnəri", "n. 风景", "The mountain scenery is beautiful.", "山间的景色很美。"], ["schedule", "ˈskedʒuːl", "n./v. 日程;安排", "My schedule is full this week.", "我这周日程很满。"], ["scheme", "skiːm", "n. 计划;方案", "They proposed a new scheme.", "他们提出了一个新方案。"], ["scholar", "ˈskɑːlər", "n. 学者", "He is a famous scholar.", "他是位著名的学者。"], ["scholarship", "ˈskɑːlərʃɪp", "n. 奖学金", "She won a full scholarship.", "她获得了全额奖学金。"], ["scratch", "skrætʃ", "v./n. 抓;刮", "The cat scratched the sofa.", "猫抓了沙发。"], ["scream", "skriːm", "v./n. 尖叫", "She screamed in fright.", "她吓得尖叫起来。"], ["seek", "siːk", "v. 寻找;寻求", "We seek a peaceful solution.", "我们寻求和平的解决办法。"], ["seize", "siːz", "v. 抓住", "Seize every chance to learn.", "抓住每一个学习的机会。"], ["select", "sɪˈlekt", "v. 挑选", "Please select the best answer.", "请选出最佳答案。"], ["sensible", "ˈsensəbl", "adj. 明智的", "That was a sensible decision.", "那是个明智的决定。"], ["sensitive", "ˈsensətɪv", "adj. 敏感的", "She is sensitive to cold.", "她对寒冷很敏感。"], ["sequence", "ˈsiːkwəns", "n. 顺序;一系列", "Put the pictures in sequence.", "把图片按顺序排列。"], ["settle", "ˈsetl", "v. 定居;解决", "They settled in a small town.", "他们在一个小镇定居。"], ["severe", "sɪˈvɪr", "adj. 严重的;严厉的", "He suffered a severe injury.", "他受了重伤。"], ["shadow", "ˈʃædoʊ", "n. 影子", "My shadow was long in the evening.", "傍晚我的影子很长。"], ["shallow", "ˈʃæloʊ", "adj. 浅的", "The river is shallow here.", "这里的河水很浅。"], ["shelter", "ˈʃeltər", "n./v. 庇护所;遮蔽", "They looked for shelter from the rain.", "他们寻找避雨的地方。"], ["shift", "ʃɪft", "v./n. 转移;轮班", "He works the night shift.", "他上夜班。"], ["shine", "ʃaɪn", "v. 照耀;发光", "The sun shines brightly.", "阳光灿烂。"], ["shortage", "ˈʃɔːrtɪdʒ", "n. 短缺", "There is a water shortage.", "水资源短缺。"], ["significant", "sɪɡˈnɪfɪkənt", "adj. 重要的;显著的", "This is a significant discovery.", "这是一项重要的发现。"], ["signal", "ˈsɪɡnəl", "n./v. 信号", "The signal was weak.", "信号很弱。"], ["sincere", "sɪnˈsɪr", "adj. 真诚的", "Please accept my sincere thanks.", "请接受我真诚的感谢。"], ["sketch", "sketʃ", "n./v. 素描;概述", "He drew a quick sketch.", "他画了一张速写。"], ["slave", "sleɪv", "n. 奴隶", "No one should be a slave.", "没有人应该成为奴隶。"], ["slice", "slaɪs", "n./v. 薄片;切", "She cut a slice of bread.", "她切了一片面包。"], ["slight", "slaɪt", "adj. 轻微的", "There was a slight change.", "有一点轻微的变化。"], ["slip", "slɪp", "v./n. 滑倒", "Be careful not to slip.", "小心别滑倒。"], ["slope", "sloʊp", "n. 斜坡", "We skied down the slope.", "我们从坡上滑下去。"], ["soar", "sɔːr", "v. 高飞;猛增", "Prices soared last year.", "去年物价飞涨。"], ["software", "ˈsɔːftwer", "n. 软件", "This software is easy to use.", "这个软件很容易使用。"], ["solar", "ˈsoʊlər", "adj. 太阳的", "Solar power is clean energy.", "太阳能是清洁能源。"], ["solid", "ˈsɑːlɪd", "adj./n. 固体的;结实的", "Ice is water in solid form.", "冰是固态的水。"], ["solution", "səˈluːʃn", "n. 解决办法", "There must be a solution.", "一定有解决办法。"], ["somewhat", "ˈsʌmwʌt", "adv. 有点", "The film was somewhat boring.", "这部电影有点无聊。"], ["sophisticated", "səˈfɪstɪkeɪtɪd", "adj. 复杂的;精密的", "This is a sophisticated machine.", "这是一台精密的机器。"], ["source", "sɔːrs", "n. 来源", "The sun is a source of energy.", "太阳是能量的来源。"], ["souvenir", "ˌsuːvəˈnɪr", "n. 纪念品", "She bought a souvenir on the trip.", "她在旅途中买了个纪念品。"], ["specialize", "ˈspeʃəlaɪz", "v. 专门从事", "She specializes in child care.", "她专门从事儿童看护。"], ["species", "ˈspiːʃiːz", "n. 物种", "Many species are in danger.", "许多物种处于危险之中。"], ["specific", "spəˈsɪfɪk", "adj. 具体的", "Please give a specific example.", "请举一个具体的例子。"], ["spectacular", "spekˈtækjələr", "adj. 壮观的", "The fireworks were spectacular.", "烟花很壮观。"], ["sphere", "sfɪr", "n. 球体;领域", "The earth is a huge sphere.", "地球是个巨大的球体。"], ["spill", "spɪl", "v. 溢出;洒", "He spilled milk on the table.", "他把牛奶洒在了桌上。"], ["spin", "spɪn", "v. 旋转", "The wheel spins fast.", "轮子转得很快。"], ["spiritual", "ˈspɪrɪtʃuəl", "adj. 精神的", "Music brings spiritual comfort.", "音乐带来精神慰藉。"], ["splendid", "ˈsplendɪd", "adj. 极好的", "We had a splendid holiday.", "我们度过了一个美妙的假期。"], ["spot", "spɑːt", "n./v. 地点;发现", "This is a good spot for a picnic.", "这是个野餐的好地方。"], ["stable", "ˈsteɪbl", "adj. 稳定的", "He has a stable job.", "他有一份稳定的工作。"], ["stack", "stæk", "n./v. 堆", "There is a stack of books.", "有一摞书。"], ["stadium", "ˈsteɪdiəm", "n. 体育场", "The stadium was full of fans.", "体育场里挤满了球迷。"], ["staff", "stæf", "n. 全体职员", "The staff are very helpful.", "员工们非常乐于助人。"], ["standard", "ˈstændərd", "n./adj. 标准", "The product meets the standard.", "这个产品符合标准。"], ["stare", "ster", "v. 盯着看", "Don't stare at strangers.", "不要盯着陌生人看。"], ["statement", "ˈsteɪtmənt", "n. 陈述;声明", "She made a clear statement.", "她做了清楚的陈述。"], ["status", "ˈsteɪtəs", "n. 地位;状态", "He has a high social status.", "他社会地位很高。"], ["steady", "ˈstedi", "adj. 稳定的", "She made steady progress.", "她稳步进步。"], ["steel", "stiːl", "n. 钢", "The bridge is made of steel.", "这座桥是钢制的。"], ["stimulate", "ˈstɪmjuleɪt", "v. 刺激;激发", "Games can stimulate learning.", "游戏能激发学习兴趣。"], ["stock", "stɑːk", "n. 存货;股票", "The shop has a large stock.", "这家店存货充足。"], ["strategy", "ˈstrætədʒi", "n. 策略", "We need a new strategy.", "我们需要新的策略。"], ["strengthen", "ˈstreŋθn", "v. 加强", "Exercise strengthens the body.", "运动强健身体。"], ["stress", "stres", "n./v. 压力;强调", "She is under a lot of stress.", "她压力很大。"], ["stretch", "stretʃ", "v. 伸展", "Stretch your arms before running.", "跑步前先伸展手臂。"], ["strike", "straɪk", "v./n. 打击;罢工", "The workers went on strike.", "工人们举行了罢工。"], ["structure", "ˈstrʌktʃər", "n. 结构", "The building has a strong structure.", "这栋楼结构坚固。"], ["struggle", "ˈstrʌɡl", "v./n. 努力;挣扎", "She struggled to learn English.", "她努力学习英语。"], ["stubborn", "ˈstʌbərn", "adj. 固执的", "He is as stubborn as a mule.", "他固执得像头骡子。"], ["submit", "səbˈmɪt", "v. 提交;服从", "Please submit your report today.", "请今天提交你的报告。"], ["substance", "ˈsʌbstəns", "n. 物质", "Water is a colorless substance.", "水是一种无色物质。"], ["substitute", "ˈsʌbstɪtuːt", "v./n. 代替;替代品", "Honey can substitute for sugar.", "蜂蜜可以代替糖。"], ["subtle", "ˈsʌtl", "adj. 微妙的", "There is a subtle difference.", "有一个微妙的差别。"], ["suburb", "ˈsʌbɜːrb", "n. 郊区", "They moved to the suburbs.", "他们搬到了郊区。"], ["sufficient", "səˈfɪʃnt", "adj. 足够的", "We have sufficient supplies.", "我们有充足的物资。"], ["summarize", "ˈsʌməraɪz", "v. 总结", "Please summarize the passage.", "请总结这篇文章。"], ["summary", "ˈsʌməri", "n. 摘要", "Write a summary of the story.", "写一篇故事梗概。"], ["superior", "suːˈpɪriər", "adj. 优越的;上级的", "This method is superior to that.", "这个方法比那个更好。"], ["supply", "səˈplaɪ", "v./n. 供应", "They supply water to the town.", "他们向镇上供水。"], ["surface", "ˈsɜːrfɪs", "n. 表面", "The surface of the lake was calm.", "湖面平静。"], ["surgeon", "ˈsɜːrdʒən", "n. 外科医生", "The surgeon saved his life.", "外科医生救了他的命。"], ["surround", "səˈraʊnd", "v. 包围", "Trees surround the house.", "树木环绕着房子。"], ["survive", "sərˈvaɪv", "v. 幸存", "Few plants survive in the desert.", "很少有植物能在沙漠中存活。"], ["suspect", "səˈspekt", "v./n. 怀疑;嫌疑人", "I suspect he is lying.", "我怀疑他在撒谎。"], ["suspend", "səˈspend", "v. 暂停;悬挂", "The game was suspended by rain.", "比赛因雨暂停。"], ["sustain", "səˈsteɪn", "v. 维持", "We must sustain our efforts.", "我们必须坚持努力。"], ["swallow", "ˈswɑːloʊ", "v./n. 吞咽;燕子", "He swallowed the pill with water.", "他就着水把药丸咽了下去。"], ["swing", "swɪŋ", "v./n. 摆动;秋千", "The children played on the swing.", "孩子们在荡秋千。"], ["switch", "swɪtʃ", "v./n. 转换;开关", "Switch off 
[["qualify", "ˈkwɑːlɪfaɪ", "v. 使合格;取得资格", "She qualified as a doctor last year.", "她去年取得了医生资格。"], ["quality", "ˈkwɑːləti", "n. 质量;品质", "This product is of high quality.", "这个产品质量很高。"], ["quantity", "ˈkwɑːntəti", "n. 数量", "We ordered a large quantity of food.", "我们订购了大量食物。"], ["quarrel", "ˈkwɔːrəl", "v./n. 争吵", "They quarreled over a small thing.", "他们为一件小事争吵。"], ["quit", "kwɪt", "v. 停止;放弃", "He quit smoking last year.", "他去年戒了烟。"], ["quote", "kwoʊt", "v./n. 引用", "She quoted a line from the poem.", "她引用了诗中的一句。"], ["racial", "ˈreɪʃl", "adj. 种族的", "We oppose racial discrimination.", "我们反对种族歧视。"], ["radiation", "ˌreɪdiˈeɪʃn", "n. 辐射", "Too much radiation is harmful.", "过量辐射有害。"], ["random", "ˈrændəm", "adj. 随机的", "The names were chosen at random.", "名字是随机选的。"], ["range", "reɪndʒ", "n./v. 范围;变动", "Prices range from ten to fifty yuan.", "价格从十元到五十元不等。"], ["rank", "ræŋk", "n./v. 等级;排名", "She ranks first in her class.", "她在班上排名第一。"], ["rapid", "ˈræpɪd", "adj. 快速的", "The city saw rapid growth.", "这座城市增长迅速。"], ["rare", "rer", "adj. 稀有的", "Pandas are rare animals.", "熊猫是稀有动物。"], ["rate", "reɪt", "n./v. 比率;速度", "The success rate is high.", "成功率很高。"], ["ratio", "ˈreɪʃioʊ", "n. 比例", "The ratio of boys to girls is equal.", "男女比例相等。"], ["raw", "rɔː", "adj. 生的;原始的", "Do not eat raw meat.", "不要吃生肉。"], ["react", "riˈækt", "v. 反应", "How did she react to the news?", "她对这个消息有何反应?"], ["reaction", "riˈækʃn", "n. 反应", "His reaction surprised us.", "他的反应让我们吃惊。"], ["realistic", "ˌriːəˈlɪstɪk", "adj. 现实的;逼真的", "Set a realistic goal.", "设定一个现实的目标。"], ["reality", "riˈæləti", "n. 现实", "Her dream became a reality.", "她的梦想变成了现实。"], ["reasonable", "ˈriːznəbl", "adj. 合理的", "The price is quite reasonable.", "价格相当合理。"], ["rebuild", "ˌriːˈbɪld", "v. 重建", "They rebuilt the old bridge.", "他们重建了那座旧桥。"], ["recall", "rɪˈkɔːl", "v. 回忆起", "I can't recall his name.", "我想不起他的名字。"], ["recognize", "ˈrekəɡnaɪz", "v. 认出;承认", "I recognized her at once.", "我立刻认出了她。"], ["recommend", "ˌrekəˈmend", "v. 推荐", "Can you recommend a good book?", "你能推荐一本好书吗?"], ["recover", "rɪˈkʌvər", "v. 恢复", "He recovered from his illness.", "他病愈了。"], ["reduce", "rɪˈduːs", "v. 减少", "We should reduce waste.", "我们应该减少浪费。"], ["refer", "rɪˈfɜːr", "v. 提到;参考", "She referred to the notes.", "她参考了笔记。"], ["reflect", "rɪˈflekt", "v. 反映;反射", "The lake reflects the sky.", "湖面倒映着天空。"], ["reform", "rɪˈfɔːrm", "v./n. 改革", "The school reformed its rules.", "学校改革了校规。"], ["regardless", "rɪˈɡɑːrdləs", "adv. 不顾;无论", "He went on regardless of the danger.", "他不顾危险继续前行。"], ["region", "ˈriːdʒən", "n. 地区", "This region is rich in coal.", "这个地区盛产煤炭。"], ["register", "ˈredʒɪstər", "v./n. 登记;注册", "Please register at the front desk.", "请在前台登记。"], ["regret", "rɪˈɡret", "v./n. 后悔", "I regret not studying harder.", "我后悔没有更努力学习。"], ["regular", "ˈreɡjələr", "adj. 规律的;定期的", "He does regular exercise.", "他定期锻炼。"], ["reject", "rɪˈdʒekt", "v. 拒绝", "They rejected his idea.", "他们否决了他的想法。"], ["relate", "rɪˈleɪt", "v. 有关联", "This relates to our topic.", "这与我们的话题有关。"], ["relationship", "rɪˈleɪʃnʃɪp", "n. 关系", "They have a close relationship.", "他们关系亲密。"], ["relative", "ˈrelətɪv", "n./adj. 亲戚;相对的", "Many relatives came to the wedding.", "许多亲戚来参加婚礼。"], ["release", "rɪˈliːs", "v./n. 释放;发布", "The film will be released soon.", "这部电影即将上映。"], ["relevant", "ˈreləvənt", "adj. 相关的", "Please give relevant examples.", "请举出相关的例子。"], ["reliable", "rɪˈlaɪəbl", "adj. 可靠的", "He is a reliable friend.", "他是个可靠的朋友。"], ["relief", "rɪˈliːf", "n. 宽慰;缓解", "It was a great relief to hear that.", "听到那消息我大大松了口气。"], ["religion", "rɪˈlɪdʒən", "n. 宗教", "People have different religions.", "人们有不同的宗教信仰。"], ["reluctant", "rɪˈlʌktənt", "adj. 不情愿的", "She was reluctant to leave.", "她不愿意离开。"], ["remark", "rɪˈmɑːrk", "n./v. 评论", "He made a kind remark.", "他说了句友善的话。"], ["remote", "rɪˈmoʊt", "adj. 遥远的;偏远的", "They live in a remote village.", "他们住在一个偏远的村庄。"], ["remove", "rɪˈmuːv", "v. 移除", "Please remove your shoes.", "请脱掉鞋子。"], ["replace", "rɪˈpleɪs", "v. 取代;替换", "We replaced the old computer.", "我们更换了旧电脑。"], ["represent", "ˌreprɪˈzent", "v. 代表", "She represents our class.", "她代表我们班。"], ["reputation", "ˌrepjuˈteɪʃn", "n. 名声", "The school has a good reputation.", "这所学校名声很好。"], ["request", "rɪˈkwest", "v./n. 请求", "She made a polite request.", "她提出了礼貌的请求。"], ["rescue", "ˈreskjuː", "v./n. 营救", "Firefighters rescued the child.", "消防员救出了那个孩子。"], ["research", "rɪˈsɜːrtʃ", "n./v. 研究", "They do research on climate.", "他们研究气候。"], ["reserve", "rɪˈzɜːrv", "v./n. 预订;保留", "I reserved a table for two.", "我预订了一张双人桌。"], ["resident", "ˈrezɪdənt", "n. 居民", "The residents welcomed us warmly.", "居民们热情地欢迎我们。"], ["resist", "rɪˈzɪst", "v. 抵抗;抵制", "She couldn't resist the cake.", "她抵挡不住蛋糕的诱惑。"], ["resolve", "rɪˈzɑːlv", "v. 解决;决心", "They resolved the conflict.", "他们解决了冲突。"], ["resource", "ˈriːsɔːrs", "n. 资源", "Water is a precious resource.", "水是宝贵的资源。"], ["respond", "rɪˈspɑːnd", "v. 回应", "He responded to my letter.", "他回复了我的信。"], ["response", "rɪˈspɑːns", "n. 回应", "There was no response to the call.", "这个呼吁没有得到回应。"], ["responsible", "rɪˈspɑːnsəbl", "adj. 负责的", "She is responsible for the team.", "她负责这个团队。"], ["restore", "rɪˈstɔːr", "v. 恢复;修复", "They restored the old temple.", "他们修复了那座古庙。"], ["restrict", "rɪˈstrɪkt", "v. 限制", "The rules restrict our freedom.", "这些规定限制了我们的自由。"], ["retire", "rɪˈtaɪər", "v. 退休", "My grandfather retired last year.", "我爷爷去年退休了。"], ["reveal", "rɪˈviːl", "v. 揭示;透露", "The study revealed the truth.", "这项研究揭示了真相。"], ["revise", "rɪˈvaɪz", "v. 修改;复习", "She revised her essay.", "她修改了她的文章。"], ["revolution", "ˌrevəˈluːʃn", "n. 革命", "The Internet caused a revolution.", "互联网带来了一场革命。"], ["reward", "rɪˈwɔːrd", "n./v. 奖励", "Hard work brings its own reward.", "努力自有回报。"], ["rhythm", "ˈrɪðəm", "n. 节奏", "I love the rhythm of this song.", "我喜欢这首歌的节奏。"], ["ridiculous", "rɪˈdɪkjələs", "adj. 荒谬的", "That's a ridiculous idea.", "那是个荒谬的主意。"], ["rob", "rɑːb", "v. 抢劫", "Someone robbed the bank.", "有人抢劫了银行。"], ["robot", "ˈroʊbɑːt", "n. 机器人", "Robots can do dangerous work.", "机器人可以做危险的工作。"], ["romantic", "roʊˈmæntɪk", "adj. 浪漫的", "They had a romantic dinner.", "他们享用了一顿浪漫的晚餐。"], ["rough", "rʌf", "adj. 粗糙的;大致的", "The road is rough and bumpy.", "这条路又粗糙又颠簸。"], ["routine", "ruːˈtiːn", "n. 常规", "Reading is part of my routine.", "阅读是我日常习惯的一部分。"], ["rural", "ˈrʊrəl", "adj. 农村的", "Life is quiet in rural areas.", "农村地区生活宁静。"]]

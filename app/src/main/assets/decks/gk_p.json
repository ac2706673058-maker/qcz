[["pace", "peɪs", "n./v. 步伐;速度", "He walked at a fast pace.", "他快步走着。"], ["package", "ˈpækɪdʒ", "n. 包裹", "The package arrived this morning.", "包裹今天早上到了。"], ["panel", "ˈpænl", "n. 专家小组;面板", "A panel of judges chose the winner.", "评审小组选出了获胜者。"], ["parallel", "ˈpærəlel", "adj. 平行的", "The two roads run parallel.", "这两条路平行延伸。"], ["participate", "pɑːrˈtɪsɪpeɪt", "v. 参加", "All students participated in the game.", "所有学生都参加了比赛。"], ["particular", "pərˈtɪkjələr", "adj. 特定的;特别的", "Is there a particular book you want?", "你想要某本特定的书吗?"], ["passion", "ˈpæʃn", "n. 激情", "She has a passion for music.", "她对音乐充满热情。"], ["passive", "ˈpæsɪv", "adj. 被动的", "Don't be so passive in class.", "上课别那么被动。"], ["pat", "pæt", "v./n. 轻拍", "She patted the dog gently.", "她轻轻地拍了拍狗。"], ["patent", "ˈpætnt", "n. 专利", "He got a patent for his invention.", "他为自己的发明申请了专利。"], ["pause", "pɔːz", "v./n. 暂停", "She paused before answering.", "她回答前停顿了一下。"], ["peak", "piːk", "n. 山顶;顶峰", "We reached the peak at dawn.", "我们黎明时到达了顶峰。"], ["penalty", "ˈpenəlti", "n. 处罚", "The penalty for cheating is harsh.", "作弊的处罚很严厉。"], ["perceive", "pərˈsiːv", "v. 察觉;感知", "We perceive colors with our eyes.", "我们用眼睛感知颜色。"], ["percent", "pərˈsent", "n. 百分之", "Ninety percent of students passed.", "百分之九十的学生通过了。"], ["perform", "pərˈfɔːrm", "v. 表演;执行", "The band performed on stage.", "乐队在台上表演。"], ["performance", "pərˈfɔːrməns", "n. 表演;表现", "Her performance was excellent.", "她的表现很出色。"], ["permanent", "ˈpɜːrmənənt", "adj. 永久的", "This is a permanent solution.", "这是个永久的解决办法。"], ["permit", "pərˈmɪt", "v./n. 允许;许可证", "Smoking is not permitted here.", "这里不允许吸烟。"], ["persist", "pərˈsɪst", "v. 坚持", "She persisted despite failure.", "尽管失败,她仍坚持着。"], ["personality", "ˌpɜːrsəˈnæləti", "n. 个性", "He has a cheerful personality.", "他性格开朗。"], ["perspective", "pərˈspektɪv", "n. 观点;视角", "Try to see it from my perspective.", "试着从我的角度看这件事。"], ["persuade", "pərˈsweɪd", "v. 说服", "I persuaded him to join us.", "我说服他加入了我们。"], ["phenomenon", "fəˈnɑːmɪnən", "n. 现象", "Rainbow is a natural phenomenon.", "彩虹是一种自然现象。"], ["philosophy", "fəˈlɑːsəfi", "n. 哲学", "She studies ancient philosophy.", "她研究古代哲学。"], ["physical", "ˈfɪzɪkl", "adj. 身体的;物理的", "Physical exercise is important.", "体育锻炼很重要。"], ["pile", "paɪl", "n./v. 堆", "There is a pile of books on the desk.", "桌上有一堆书。"], ["pill", "pɪl", "n. 药丸", "Take one pill after meals.", "饭后服一片药。"], ["pioneer", "ˌpaɪəˈnɪr", "n. 先驱", "She was a pioneer in medicine.", "她是医学领域的先驱。"], ["pity", "ˈpɪti", "n./v. 遗憾;同情", "What a pity you can't come!", "你不能来真遗憾!"], ["planet", "ˈplænɪt", "n. 行星", "Earth is the third planet from the sun.", "地球是离太阳第三近的行星。"], ["poison", "ˈpɔɪzn", "n./v. 毒药;使中毒", "Some plants contain poison.", "有些植物含有毒素。"], ["policy", "ˈpɑːləsi", "n. 政策", "The new policy helps farmers.", "新政策帮助农民。"], ["polish", "ˈpɑːlɪʃ", "v. 擦亮;润色", "He polished his shoes.", "他把鞋子擦亮了。"], ["portion", "ˈpɔːrʃn", "n. 部分;份", "She gave a portion to each child.", "她给每个孩子分了一份。"], ["portrait", "ˈpɔːrtrət", "n. 肖像", "She painted a portrait of her father.", "她画了一幅她父亲的肖像。"], ["positive", "ˈpɑːzətɪv", "adj. 积极的;正的", "Keep a positive attitude.", "保持积极的态度。"], ["possess", "pəˈzes", "v. 拥有", "He possesses great talent.", "他拥有非凡的才能。"], ["postpone", "poʊˈspoʊn", "v. 推迟", "The meeting was postponed.", "会议被推迟了。"], ["potential", "pəˈtenʃl", "n./adj. 潜力;潜在的", "She has great potential.", "她潜力巨大。"], ["poverty", "ˈpɑːvərti", "n. 贫穷", "Education helps fight poverty.", "教育有助于消除贫困。"], ["precious", "ˈpreʃəs", "adj. 珍贵的", "Time is precious; don't waste it.", "时间宝贵,不要浪费。"], ["precise", "prɪˈsaɪs", "adj. 精确的", "Give me the precise figures.", "给我精确的数字。"], ["predict", "prɪˈdɪkt", "v. 预测", "No one can predict the future.", "没人能预测未来。"], ["prefer", "prɪˈfɜːr", "v. 更喜欢", "I prefer tea to coffee.", "比起咖啡我更喜欢茶。"], ["pregnant", "ˈpreɡnənt", "adj. 怀孕的", "She is six months pregnant.", "她怀孕六个月了。"], ["prejudice", "ˈpredʒudɪs", "n. 偏见", "We should get rid of prejudice.", "我们应该消除偏见。"], ["preserve", "prɪˈzɜːrv", "v. 保护;保存", "We must preserve old buildings.", "我们必须保护古建筑。"], ["press", "pres", "v./n. 按;新闻界", "Press the button to start.", "按按钮启动。"], ["pressure", "ˈpreʃər", "n. 压力", "Students face a lot of pressure.", "学生面临很大压力。"], ["previous", "ˈpriːviəs", "adj. 先前的", "We met on a previous occasion.", "我们之前见过面。"], ["principle", "ˈprɪnsəpl", "n. 原则", "He never breaks his principles.", "他从不违背自己的原则。"], ["priority", "praɪˈɔːrəti", "n. 优先;优先事项", "Health is my top priority.", "健康是我的首要任务。"], ["privacy", "ˈpraɪvəsi", "n. 隐私", "Everyone has a right to privacy.", "每个人都有隐私权。"], ["private", "ˈpraɪvət", "adj. 私人的", "This is a private conversation.", "这是私人谈话。"], ["procedure", "prəˈsiːdʒər", "n. 程序;步骤", "Follow the correct procedure.", "按正确的步骤操作。"], ["process", "ˈprɑːses", "n./v. 过程;处理", "Learning is a slow process.", "学习是个缓慢的过程。"], ["profession", "prəˈfeʃn", "n. 职业", "Teaching is a noble profession.", "教书是一份崇高的职业。"], ["professional", "prəˈfeʃənl", "adj./n. 专业的", "She is a professional dancer.", "她是一名专业舞者。"], ["professor", "prəˈfesər", "n. 教授", "The professor gave a great lecture.", "教授做了一场精彩的讲座。"], ["profit", "ˈprɑːfɪt", "n./v. 利润", "The company made a big profit.", "公司获得了丰厚的利润。"], ["profound", "prəˈfaʊnd", "adj. 深刻的", "The book had a profound effect on me.", "这本书对我影响深远。"], ["prohibit", "prəˈhɪbɪt", "v. 禁止", "The law prohibits drunk driving.", "法律禁止酒后驾驶。"], ["project", "ˈprɑːdʒekt", "n./v. 项目;计划", "We finished the science project.", "我们完成了科学项目。"], ["prominent", "ˈprɑːmɪnənt", "adj. 杰出的;显著的", "He is a prominent scientist.", "他是一位杰出的科学家。"], ["promote", "prəˈmoʊt", "v. 促进;晋升", "Reading promotes creativity.", "阅读能促进创造力。"], ["prompt", "prɑːmpt", "adj./v. 迅速的;促使", "Thank you for your prompt reply.", "感谢你的及时回复。"], ["property", "ˈprɑːpərti", "n. 财产;性质", "He owns a lot of property.", "他拥有很多财产。"], ["proportion", "prəˈpɔːrʃn", "n. 比例", "A large proportion of students agreed.", "很大比例的学生同意了。"], ["proposal", "prəˈpoʊzl", "n. 提议;建议", "The committee accepted the proposal.", "委员会接受了这个提议。"], ["propose", "prəˈpoʊz", "v. 提议", "I propose we take a break.", "我建议我们休息一下。"], ["prospect", "ˈprɑːspekt", "n. 前景", "The job has good prospects.", "这份工作前景很好。"], ["protest", "prəˈtest", "v./n. 抗议", "They protested against the plan.", "他们抗议这个计划。"], ["prove", "pruːv", "v. 证明", "He proved that he was right.", "他证明了自己是对的。"], ["psychology", "saɪˈkɑːlədʒi", "n. 心理学", "She is interested in psychology.", "她对心理学感兴趣。"], ["publish", "ˈpʌblɪʃ", "v. 出版;发表", "He published his first novel.", "他出版了他的第一部小说。"], ["punishment", "ˈpʌnɪʃmənt", "n. 惩罚", "The punishment was too severe.", "这个惩罚太严厉了。"], ["purchase", "ˈpɜːrtʃəs", "v./n. 购买", "She purchased a new laptop.", "她购买了一台新笔记本电脑。"], ["pure", "pjʊr", "adj. 纯的", "The water here is pure and clean.", "这里的水纯净又干净。"], ["purpose", "ˈpɜːrpəs", "n. 目的", "What is the purpose of your visit?", "你来访的目的是什么?"], ["pursue", "pərˈsuː", "v. 追求", "She decided to pursue her dream.", "她决定追寻自己的梦想。"]]
